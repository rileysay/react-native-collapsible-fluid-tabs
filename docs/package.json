    "motion": "13.2.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reicon-react": "1.2.5",
    "tailwind-merge": "3.7.0"
